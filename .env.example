# Copy this file to .env.local and fill it in. .env.local is gitignored.
# Only TMDB_TOKEN is required. Leave the Seerr lines empty if you don't use Seerr.
# These stay on the server: they're never built into the page.

# TMDB API Read Access Token: themoviedb.org -> Settings -> API.
# The long one that starts with eyJ, not the shorter API Key.
TMDB_TOKEN=

# Optional: Seerr, for the "Request it" button. Leave these empty to turn it off.
# SEERR_URL is the address ReelMind's server uses to reach Seerr:
#   http://seerr:5055         ReelMind in Docker, on the same network as Seerr
#   http://<server-ip>:5055   ReelMind on another computer
SEERR_URL=
# Seerr -> Settings -> General -> API Key
SEERR_API_KEY=

# Port for `npm start` (default 4173). `npm run dev` uses 5173.
# PORT=4173

# Where `npm start` saves profiles (default: profiles.json in the project folder).
# The Docker image sets this to /app/data/profiles.json. `npm run dev` always
# uses profiles.json in the project folder.
# PROFILES_FILE=profiles.json
